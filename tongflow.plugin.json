{
    "plugin": {
        "name": "FFmpeg",
        "description": "Media transcoding, muxing, and frame/track extraction with FFmpeg. No model weights — pure media processing.",
        "icon": "/plugins/tongflow-modal-ffmpeg.svg"
    },
    "env": [
        {
            "key": "MODAL_TOKEN_ID",
            "required": true,
            "description": "Modal token id",
            "url": "https://modal.com/settings/tokens"
        },
        {
            "key": "MODAL_TOKEN_SECRET",
            "required": true,
            "description": "Modal token secret (paired with MODAL_TOKEN_ID)"
        },
        {
            "key": "TONGFLOW_MODAL_CALL_TIMEOUT_S",
            "default": "2400",
            "description": "Max seconds to wait for a Modal call"
        }
    ]
}
